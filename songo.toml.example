# Copier en `songo.toml` (ignore par git) et ajuster a la machine.
# Priorite : valeurs par defaut du code < ce fichier < variables d'env SONGO_*
# Voir docs/trainer/provider-architecture.md

[runtime]
# "local" (cette machine) ou "gcp" (VM Compute Engine jetable pour une
# campagne d'annotation massive). Defaut : local.
provider = "local"

# Racine des artefacts : datasets/, checkpoints/, caches d'annotations.
# METTRE SUR LE SSD INTERNE -- pas un dossier OneDrive / lecteur reseau
# (SQLite WAL du cache d'annotations ne supporte pas les partages reseau).
# Windows : chemin avec des slashs avant, ex "D:/songo-data".
data_root = "D:/songo-data"

# Workers d'annotation (Phase 2 du build : nombre de positions annotees en
# parallele). Defaut du code = moitie des coeurs logiques. Chaque worker
# porte sa propre table de transposition de plusieurs Mo -- ne pas mettre
# tous les threads, la RAM et la contention SQLite en patissent. Baisser si
# la RAM sature pendant la generation.
num_workers = 6

# "cpu" (defaut, recommande : le reseau est minuscule, le GPU n'aide pas),
# "cuda", ou "auto" (cuda si dispo).
device = "cpu"

[runtime.gcp]
# Utilise seulement quand provider = "gcp". Prefixe "pilots" encore code en
# dur dans apps/trainer/scripts/*.sh (changer aux deux endroits si besoin).
bucket = "gs://songo-model-ai-vertex-bucket-001"
project = "songo-model-ai"
zone = "us-central1-a"
machine_type = "c2d-highcpu-32"
max_run_duration_s = 43200
