.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Config runtime propre a la machine (provider, data_root, workers).
# Versionne : songo.toml.example
songo.toml

# Datasets, cache d'annotations et checkpoints generes : regenerables,
# destines a Cloud Storage (section 11.1 du plan), pas au depot git.
data/

# Exception : conserver dans Git le dataset de VRAIES parties humaines,
# petit, nettoye et reproductible (source precieuse, pas un artefact
# regenerable a la volee). Deplace depuis apps/data/ordonnées vers
# data/real_matches (juillet 2026). Les exports Firebase bruts
# (data/real_matches/brutes/, PII) et tout le reste de data/ restent ignores.
!data/real_matches/
data/real_matches/*
!data/real_matches/match_moves_v1.json
!data/real_matches/match_moves_v1.jsonl
