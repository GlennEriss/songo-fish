.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.DS_Store

# Datasets, cache d'annotations et checkpoints generes : regenerables,
# destines a Cloud Storage (section 11.1 du plan), pas au depot git.
data/

# Conserver dans Git uniquement le dataset humain nettoye et reproductible.
# Les exports Firebase bruts et les autres artefacts de apps/data restent ignores.
!apps/data/
apps/data/*
!apps/data/ordonnées/
apps/data/ordonnées/*
!apps/data/ordonnées/match_moves_v1.json
!apps/data/ordonnées/match_moves_v1.jsonl
